# Leave empty in development (Vite forwards /api and /ws to localhost:8080).
# In production set it to the backend URL, e.g. https://api.example.com
VITE_API_URL=
# Local use only: this gets built into the page, where anyone can read it.
# On a hosted copy leave it empty and set DASHBOARD_PASSWORD in the backend instead.
VITE_DASHBOARD_TOKEN=
